{
  "name": "openapi-platform",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check:dead-code": "knip",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:api-service": "vitest run --config vitest.api-service.config.ts",
    "test:integration": "pnpm build && pnpm test:integration:built",
    "test:integration:built": "vitest run --config vitest.integration.config.ts",
    "test:run": "pnpm test:unit && pnpm test:integration"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/mdi": "^1.2.3",
    "@internationalized/date": "3.12.4",
    "@nuxt/ui": "^4.11.2",
    "@unovis/vue": "^1.7.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "bowser": "^2.14.1",
    "drizzle-orm": "^0.45.3",
    "h3": "1.15.11",
    "ioredis": "5.11.1",
    "nodemailer": "^10.0.10",
    "nuxt": "^4.5.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "undici": "^8.11.2",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "knip": "6.38.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.20.0"
}
