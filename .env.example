# Configure two independent 32-byte secrets yourself. Startup only reads them.
NUXT_AUTH_SECRET=
NUXT_API_KEY_SECRET=

# Leave DATABASE_URL empty to use PGlite at .data/pglite. For PostgreSQL,
# set the URL below. Percent-encode
# reserved characters in the username/password. Use sslmode=require when the
# database provider requires TLS.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/openapi

# Optional persistent data root. Relative paths resolve beside this .env file.
# Both the application and migration runner use <PLATFORM_DATA_DIR>/pglite.
# PLATFORM_DATA_DIR=.data
# NITRO_HOST=127.0.0.1
# NITRO_PORT=3000

# Redis is optional for one Platform process. Set NUXT_REDIS_URL for shared
# limits, caches, and coordination; once configured, coordination is fail-closed.
# /0 is the Redis database number; rediss:// enables TLS.
NUXT_REDIS_URL=
# NUXT_REDIS_URL=redis://default:change-me@127.0.0.1:6379/0
